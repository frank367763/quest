<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/black">

    <TextView
        android:id="@+id/question_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textColor="@color/orange"
        android:textSize="28sp">
    </TextView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="10dp">

        <Button
            android:id="@+id/v1"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:text="@string/v1_1"
            app:cornerRadius="0dp"
            android:textSize="24sp"
            app:backgroundTint="@color/orange"
            android:textColor="@color/black"
            android:padding="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp">
        </Button>

        <Button
            android:id="@+id/v2"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:text="@string/v1_2"
            app:cornerRadius="0dp"
            android:textSize="24sp"
            app:backgroundTint="@color/orange"
            android:textColor="@color/black"
            android:padding="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp">
        </Button>

        <Button
            android:id="@+id/v3"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:text="@string/v1_3"
            app:cornerRadius="0dp"
            android:textSize="24sp"
            app:backgroundTint="@color/orange"
            android:textColor="@color/black"
            android:padding="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            >
        </Button>
        <Button
            android:id="@+id/developers"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:text="@string/developers"
            app:cornerRadius="0dp"
            android:textSize="24sp"
            app:backgroundTint="@color/white"
            android:textColor="@color/orange"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="5dp">
        </Button>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="10dp">

        <Button
            android:id="@+id/v4"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:text="@string/v1_4"
            app:cornerRadius="0dp"
            android:textSize="24sp"
            app:backgroundTint="@color/orange"
            android:textColor="@color/black"
            android:padding="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp">
        </Button>

        <Button
            android:id="@+id/v5"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:text="@string/v1_5"
            app:cornerRadius="0dp"
            android:textSize="24sp"
            app:backgroundTint="@color/orange"
            android:textColor="@color/black"
            android:padding="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp">
        </Button>

        <Button
            android:id="@+id/v6"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:text="@string/v1_6"
            app:cornerRadius="0dp"
            android:textSize="24sp"
            app:backgroundTint="@color/orange"
            android:textColor="@color/black"
            android:padding="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp">
        </Button>

        <Button
            android:id="@+id/help"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:text="@string/help"
            android:textColor="@color/orange"
            android:textSize="24sp"
            app:backgroundTint="@color/white"
            app:cornerRadius="0dp"
            android:layout_marginTop="5dp"></Button>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="10dp">

        <ImageButton
            android:id="@+id/previous_button"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="8dp"
            android:backgroundTint="@color/white"
            android:src="@drawable/arrow_left"
            android:contentDescription="@string/previous_button" />

        <ImageButton
            android:id="@+id/next_button"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="8dp"
            android:backgroundTint="@color/white"
            android:src="@drawable/arrow_right"
            android:contentDescription="@string/next_button" />

    </LinearLayout>
</LinearLayout>